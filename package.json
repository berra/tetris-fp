{
  "name": "tetris-fp",
  "homepage": "http://",
  "version": "1.0.1",
  "main": "dist/index.js",
  "license": "MIT",
  "peerDependencies": {
    "fp-ts": "^2.9.5"
  },
  "devDependencies": {
    "@types/jest": "^26.0.20",
    "@typescript-eslint/eslint-plugin": "^4.25.0",
    "@typescript-eslint/parser": "^4.25.0",
    "cspell": "^5.5.2",
    "docs-ts": "^0.6.10",
    "esbuild": "^0.28.2",
    "eslint": "^7.27.0",
    "fast-check": "^2.13.0",
    "fp-ts": "^2.9.5",
    "jest": "^26.6.3",
    "markdown-magic": "^2.0.0",
    "prettier": "^2.2.1",
    "prettier-plugin-jsdoc": "^0.3.13",
    "serve": "^14.2.6",
    "ts-jest": "^26.5.3",
    "typescript": "^4.2.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:browser",
    "build:browser": "esbuild src/browser/main.ts --bundle --outfile=dist/game.js --format=iife --target=es2017",
    "postbuild": "node -e \"require('./dist').writeGameToHtmlFile('./dist/tetris.html')()\" && cp dist/tetris.html dist/index.html",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "start": "serve dist -p 7878",
    "prepublish": "npm run build",
    "pretty": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "docs": "docs-ts",
    "spell": "cspell '**/*.*'",
    "md": "markdown"
  }
}
